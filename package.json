{
	"name": "better-embedded-canvas",
	"version": "1.2.0",
	"description": "Give your embedded canvas better display and interactivity.",
	"main": "dist/main.js",
	"scripts": {
		"lint": "tsx scripts/lint.mts",
		"lint:auto-fix": "tsx scripts/lint.mts auto-fix",
		"build": "tsc -noEmit -skipLibCheck && tsx scripts/build.mts",
