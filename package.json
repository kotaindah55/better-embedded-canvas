		"build:styles": "tsx scripts/build-styles.mts",
		"build:styles:dev": "tsx scripts/build-styles.mts dev",
		"version": "tsx scripts/bump-version.mts",
		"version:auto-push": "tsx scripts/bump-version.mts auto-push",
		"lock": "tsx scripts/lock-package.mts",
		"lock:auto-push": "tsx scripts/lock-package.mts auto-push",
		"publish": "tsx scripts/publish.mts",
		"changelog": "tsx scripts/print-changelog.mts"
